NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL publik aplikasi untuk redirect email reset sandi.
# Contoh produksi: https://gurupintar.example.com
NEXT_PUBLIC_SITE_URL=

# Command Code Provider API (pay-as-you-go). Buat API key di Studio.
COMMAND_CODE_API_KEY=
AI_MODEL=deepseek/deepseek-v4.1-flash
# COMMAND_CODE_BASE_URL=https://api.commandcode.ai/provider/v1

# Gemini TTS dari Google AI Studio (free tier). Hanya di server; jangan pakai NEXT_PUBLIC_.
GEMINI_API_KEY=
# GOOGLE_API_KEY=  # alternatif jika memakai nama env Google
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts

# Bootstrap super-admin pertama (hanya dipakai scripts/buat-super-admin.mjs)
SUPER_ADMIN_NAMA=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Kode undangan untuk halaman /daftar/super-admin. Kosongkan untuk menutup pendaftaran.
KODE_UNDANGAN_SUPER_ADMIN=

# Nomor WhatsApp admin untuk top up koin, contoh 6281234567890
WHATSAPP_ADMIN=

# Cadangan lama jika COMMAND_CODE_API_KEY belum diisi.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
KODE_UNDANGAN_GURU=
