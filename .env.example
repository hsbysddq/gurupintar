# GOOGLE_API_KEY=  # alternatif jika memakai nama env Google
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

# Nomor WhatsApp admin untuk top up koin, contoh 6281234567890
WHATSAPP_ADMIN=

# Cadangan lama jika COMMAND_CODE_API_KEY belum diisi.
ANTHROPIC_API_KEY=
